# HTTP server
PORT=3000
# Public base URL used to build absolute file links returned to clients/bot.
PUBLIC_BASE_URL=http://localhost:3000
# CORS origin of the frontend dev server (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:5173

# Local storage root (results are written here, served under /files)
STORAGE_ROOT=./storage

# How long a calculation's artifacts stay on disk before being swept, in hours. 0 disables the
# sweep. Bounds disk use at roughly: calcs_per_hour * (TTL + sweep interval) * 1.1 MB.
# Downloads on an already-open result page stop working once its artifacts expire.
STORAGE_TTL_HOURS=48
# How often to look for expired calculations, in minutes. Only affects overshoot: a directory
# lives between TTL and TTL + this.
STORAGE_SWEEP_INTERVAL_MINUTES=60

# Request logs root (success.log and errors.log are appended here)
LOGS_ROOT=./logs

# Max concurrent+queued jobs before new requests are rejected (429)
QUEUE_MAX=25

# Telegram bot token from @BotFather. Leave empty to disable the bot.
BOT_TOKEN=
# Optional HTTP proxy for outbound Telegram traffic (needed where Node can't reach
# api.telegram.org directly). Supports Basic auth in the URL, e.g. http://user:pass@host:port
BOT_PROXY_URL=
